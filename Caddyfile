{
    # Global options
    # Optional: set admin listener or email for ACME
}

# Serve the frontend and reverse-proxy /api to backend defined by BACKEND_URL env var
:80, :443 {
    encode gzip

    @api {
        path /api/*
    }

    # Reverse proxy to BACKEND_URL when set; fall back to localhost:3000 so Caddy can start
    # If you set BACKEND_URL in Railway env to your API HTTPS URL, that will be used.
    reverse_proxy @api {env.BACKEND_URL} 127.0.0.1:3000

    root * /build
    file_server
    try_files {path} /index.html
}
